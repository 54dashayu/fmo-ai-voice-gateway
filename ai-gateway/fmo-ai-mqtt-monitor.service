[Unit]
Description=FMO AI read-only MQTT monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fmo-ai
Group=fmo-ai
WorkingDirectory=/opt/fmo-ai-gateway
EnvironmentFile=/etc/fmo-ai-gateway.env
Environment=FMO_GATEWAY_CONFIG_PATH=/etc/fmo-ai-gateway/gateway-config.json
ExecStartPre=/usr/bin/test -w /var/lib/fmo-ai-gateway/audio
ExecStart=/opt/fmo-ai-gateway/venv/bin/python /opt/fmo-ai-gateway/mqtt_monitor.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RuntimeDirectory=fmo-ai-mqtt
RuntimeDirectoryMode=0700
StateDirectory=fmo-ai-gateway
StateDirectoryMode=0700
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=48M
TasksMax=16
[Install]
WantedBy=multi-user.target
