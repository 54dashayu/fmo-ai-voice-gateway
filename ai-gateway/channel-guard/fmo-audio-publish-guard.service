[Unit]
Description=FMO activity broker publish guard
After=emqx.service
PartOf=emqx.service
[Service]
Type=oneshot
User=emqx
Group=emqx
Environment=HOME=/var/lib/emqx
RuntimeDirectory=fmo-audio-hook
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 /opt/fmo-ai-gateway/channel-guard/load.py
RemainAfterExit=true
[Install]
WantedBy=emqx.service
