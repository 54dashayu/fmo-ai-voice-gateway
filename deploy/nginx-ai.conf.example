location = /ai {
    return 301 /ai/;
}

location ^~ /ai/ {
    auth_basic "FMO AI Admin";
    auth_basic_user_file /etc/nginx/auth/fmo-ai.htpasswd;
    proxy_pass http://127.0.0.1:18788/ai/;
    proxy_set_header Host $host;
    add_header Cache-Control "no-store";
}

location = /ai/api/status {
    auth_basic "FMO AI Admin";
    auth_basic_user_file /etc/nginx/auth/fmo-ai.htpasswd;
    proxy_pass http://127.0.0.1:18788/status;
    add_header Cache-Control "no-store";
}

location ~ ^/ai/api/(gateway-config|blacklist|control|persona)$ {
    auth_basic "FMO AI Admin";
    auth_basic_user_file /etc/nginx/auth/fmo-ai.htpasswd;
    proxy_pass http://127.0.0.1:18788/admin/$1;
    proxy_set_header X-FMO-Admin 1;
    proxy_set_header Host $host;
    client_max_body_size 2m;
    add_header Cache-Control "no-store";
}

location = /ai/api/knowledge/overview {
    auth_basic "FMO AI Admin";
    auth_basic_user_file /etc/nginx/auth/fmo-ai.htpasswd;
    proxy_pass http://127.0.0.1:18788/admin/knowledge/overview;
    proxy_set_header X-FMO-Admin 1;
    add_header Cache-Control "no-store";
}

location = /ai/api/knowledge/files {
    auth_basic "FMO AI Admin";
    auth_basic_user_file /etc/nginx/auth/fmo-ai.htpasswd;
    proxy_pass http://127.0.0.1:18788/admin/knowledge/files$is_args$args;
    proxy_set_header X-FMO-Admin 1;
    add_header Cache-Control "no-store";
}

location = /ai/api/knowledge/upload {
    auth_basic "FMO AI Admin";
    auth_basic_user_file /etc/nginx/auth/fmo-ai.htpasswd;
    proxy_pass http://127.0.0.1:18788/admin/knowledge/upload;
    proxy_set_header X-FMO-Admin 1;
    client_max_body_size 2m;
    proxy_read_timeout 30s;
    add_header Cache-Control "no-store";
}
